{
  "name": "Camara Dark Teal",
  "dataColors": [
    "#4EB6AF", "#5FC4BD", "#3D9A94", "#7FDBD4",
    "#4E89B6", "#5FC48B", "#D6C46B", "#EE9DA2",
    "#A8AEB5", "#6B7178"
  ],
  "background": "#2F3239",
  "backgroundLight": "#3A3F45",
  "backgroundNeutral": "#41464D",
  "foreground": "#F2F4F5",
  "foregroundNeutralSecondary": "#A8AEB5",
  "foregroundNeutralTertiary": "#6B7178",
  "tableAccent": "#4EB6AF",
  "good": "#5FC48B",
  "neutral": "#D6C46B",
  "bad": "#EE9DA2",
  "maximum": "#4EB6AF",
  "center": "#A8AEB5",
  "minimum": "#2F3239",
  "hyperlink": "#5FC4BD",
  "textClasses": {
    "title": {
      "fontSize": 13,
      "fontFace": "DIN",
      "color": "#F2F4F5"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "DIN",
      "color": "#F2F4F5"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "DIN Light",
      "color": "#A8AEB5"
    },
    "callout": {
      "fontSize": 26,
      "fontFace": "DIN",
      "color": "#F2F4F5"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          { "show": true, "transparency": 100 }
        ],
        "border": [
          { "show": false }
        ],
        "visualHeader": [
          { "show": false }
        ],
        "dropShadow": [
          { "show": false }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#F2F4F5" } },
            "background": { "solid": { "color": "#00000000" } },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "DIN"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#A8AEB5" } },
            "alignment": "left",
            "fontSize": 10
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#F2F4F5" } },
            "fontSize": 10,
            "fontFamily": "DIN Light"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#A8AEB5" } },
            "fontSize": 10,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#A8AEB5" } },
            "fontSize": 10,
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#4A4F56" } },
            "gridlineThickness": 1,
            "gridlineStyle": "solid",
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#A8AEB5" } },
            "fontSize": 10,
            "showTitle": false,
            "position": "TopCenter"
          }
        ],
        "wordWrap": [
          { "show": true }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#F2F4F5" } },
            "fontSize": 26,
            "fontFamily": "DIN"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#A8AEB5" } },
            "fontSize": 11
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": { "solid": { "color": "#A8AEB5" } },
            "background": { "solid": { "color": "#3A3F45" } },
            "fontSize": 10
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#F2F4F5" } },
            "fontSize": 11
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#4A4F56" } },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#F2F4F5" } },
            "backColor": { "solid": { "color": "#3A3F45" } },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#F2F4F5" } },
            "backColorPrimary": { "solid": { "color": "#00000000" } },
            "fontColorSecondary": { "solid": { "color": "#F2F4F5" } },
            "backColorSecondary": { "solid": { "color": "#00000000" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}