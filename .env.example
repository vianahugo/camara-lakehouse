# ---- Postgres local (a nossa "producao") ----
PGHOST=localhost
PGPORT=5433
PGDATABASE=camara
PGUSER=camara
PGPASSWORD=camara

# ---- Databricks Free Edition ----
# Host: copie da barra de enderecos do workspace, sem barra no final
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
# Jobs & Pipelines > seu job: o numero na URL
DATABRICKS_JOB_ID=

# ---- Destino no Unity Catalog ----
UC_VOLUME_ROOT=/Volumes/camara/raw/landing
